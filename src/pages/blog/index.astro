---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import BlogCard from '../../components/BlogCard.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const allTags = [...new Set(posts.flatMap(p => p.data.tags))].sort();
---

<Layout
  title="Writing — Naz Özbek"
  description="Essays on architecture, migration, urbanism, and the built environment by Özlem Naz Özbek."
>
  <Navbar />
  <main class="blog-index">
    <div class="container">
      <header class="blog-index__header">
        <p class="section-label">Writing</p>
        <h1 class="blog-index__title">Essays & Notes</h1>
        <p class="blog-index__subtitle">Thoughts on architecture, migration, urban form, and the spaces we inhabit.</p>
      </header>

      {allTags.length > 0 && (
        <div class="filter-bar">
          <span class="filter-label">Topics:</span>
          <div class="filter-tags">
            {allTags.map(tag => <span class="tag tag--muted">{tag}</span>)}
          </div>
        </div>
      )}

      {posts.length === 0 ? (
        <div class="empty-state">
          <p>No essays yet — check back soon.</p>
        </div>
      ) : (
        <div class="blog-grid">
          {posts.map(post => (
            <BlogCard
              title={post.data.title}
              description={post.data.description}
              pubDate={post.data.pubDate}
              slug={post.id}
              tags={post.data.tags}
            />
          ))}
        </div>
      )}
    </div>
  </main>
  <Footer />
</Layout>

<style>
.blog-index {
  padding-top: calc(var(--nav-height) + var(--space-9));
  padding-bottom: var(--space-10);
}

.blog-index__header {
  margin-bottom: var(--space-7);
}

.blog-index__title {
  font-size: clamp(2rem, 4vw, 3rem);
  margin-bottom: var(--space-4);
}

.blog-index__subtitle {
  max-width: 50ch;
  font-size: 1.05rem;
  color: var(--text-secondary);
}

.filter-bar {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  margin-bottom: var(--space-7);
  flex-wrap: wrap;
  padding: var(--space-4) var(--space-5);
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
}

.filter-label {
  font-size: 0.8rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--text-muted);
  flex-shrink: 0;
}

.filter-tags {
  display: flex;
  gap: var(--space-2);
  flex-wrap: wrap;
}

.blog-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  gap: var(--space-5);
}

.empty-state {
  text-align: center;
  padding: var(--space-10) 0;
  color: var(--text-muted);
}
</style>
