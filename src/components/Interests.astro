---
import { interests, skills } from '../data/interests';
---

<section class="interests-section" id="interests">
  <div class="container">
    <p class="section-label">Expertise</p>
    <h2 class="section-title">Interests & Skills</h2>

    <div class="interests-layout">
      <div class="interests-block">
        <h3 class="block-label">Research Interests</h3>
        <div class="tag-cloud">
          {interests.map(item => <span class="tag">{item}</span>)}
        </div>
      </div>

      <div class="interests-block">
        <h3 class="block-label">Tools & Disciplines</h3>
        <div class="skills-list">
          {skills.map(skill => (
            <div class="skill-item">
              <span class="skill-name">{skill.name}</span>
              <span class="skill-cat tag tag--muted">{skill.category}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
.section-title { margin-bottom: var(--space-7); }

.interests-layout {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-8);
}

.block-label {
  font-size: 0.8rem;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--text-muted);
  margin-bottom: var(--space-4);
}

.tag-cloud {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
}

.skills-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

.skill-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-3) var(--space-4);
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  transition: border-color var(--transition);
}
.skill-item:hover { border-color: var(--border-dark); }

.skill-name {
  font-size: 0.9rem;
  font-weight: 500;
  color: var(--text-primary);
}

.skill-cat { font-size: 0.7rem; }

@media (max-width: 640px) {
  .interests-layout {
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }
}
</style>
