---
import { experiences } from '../data/experience';
---

<section class="experience-section" id="experience">
  <div class="container">
    <p class="section-label">Work</p>
    <h2 class="section-title">Experience</h2>

    <div class="timeline">
      {experiences.map((job, i) => (
        <div class="timeline__item" data-index={i}>
          <div class="timeline__marker">
            <div class="timeline__dot"></div>
            {i < experiences.length - 1 && <div class="timeline__line"></div>}
          </div>
          <div class="timeline__content">
            <div class="timeline__header">
              <div>
                <h3 class="timeline__title">{job.title}</h3>
                <p class="timeline__company">
                  {job.companyUrl
                    ? <a href={job.companyUrl} target="_blank" rel="noopener">{job.company}</a>
                    : job.company
                  }
                  <span class="timeline__location"> · {job.location}</span>
                </p>
              </div>
              <div class="timeline__dates">
                <span class="timeline__date">{job.dateStart}</span>
                <span class="timeline__dash">—</span>
                <span class:list={['timeline__date', { 'timeline__date--current': !job.dateEnd }]}>
                  {job.dateEnd ?? 'Present'}
                </span>
              </div>
            </div>
            {job.description.length > 0 && (
              <ul class="timeline__desc">
                {job.description.map(item => <li>{item}</li>)}
              </ul>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
.section-title {
  margin-bottom: var(--space-7);
}

.timeline {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.timeline__item {
  display: grid;
  grid-template-columns: 32px 1fr;
  gap: var(--space-5);
}

.timeline__marker {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 4px;
}

.timeline__dot {
  width: 12px;
  height: 12px;
  border-radius: 50%;
  background: var(--accent);
  border: 2px solid var(--bg);
  outline: 2px solid var(--accent);
  flex-shrink: 0;
}

.timeline__line {
  flex: 1;
  width: 1px;
  background: var(--border);
  margin: var(--space-2) 0;
  min-height: var(--space-6);
}

.timeline__content {
  padding-bottom: var(--space-7);
}

.timeline__header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: var(--space-4);
  flex-wrap: wrap;
  margin-bottom: var(--space-3);
}

.timeline__title {
  font-size: 1.05rem;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: var(--space-1);
}

.timeline__company {
  font-size: 0.9rem;
  color: var(--text-secondary);
  margin: 0;
}
.timeline__company a { color: var(--accent); font-weight: 500; }
.timeline__company a:hover { color: var(--accent-hover); }

.timeline__location {
  color: var(--text-muted);
}

.timeline__dates {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  flex-shrink: 0;
}

.timeline__date {
  font-size: 0.8125rem;
  font-weight: 500;
  color: var(--text-muted);
}

.timeline__dash { color: var(--border-dark); }

.timeline__date--current {
  color: var(--accent);
  font-weight: 600;
}

.timeline__desc {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.timeline__desc li {
  font-size: 0.9rem;
  color: var(--text-secondary);
  padding-left: var(--space-4);
  position: relative;
  line-height: 1.6;
}
.timeline__desc li::before {
  content: '›';
  position: absolute;
  left: 0;
  color: var(--accent);
  font-weight: 700;
}

@media (max-width: 480px) {
  .timeline__header { flex-direction: column; }
  .timeline__dates { order: -1; }
}
</style>
