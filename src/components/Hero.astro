---
import { profile } from '../data/profile';
---

<section class="hero" id="hero">
  <div class="container">
    <div class="hero__layout">
      <div class="hero__text">
        <p class="section-label">Portfolio</p>
        <h1 class="hero__name">{profile.name}</h1>
        <p class="hero__role">{profile.role} <span class="hero__org">· <a href={profile.organizationUrl} target="_blank" rel="noopener">{profile.organization}</a></span></p>
        <p class="hero__bio">{profile.bioShort}</p>

        <div class="hero__actions">
          <a href="#about" class="btn btn-primary">About me</a>
          <a href="/cv" class="btn btn-outline">View CV</a>
        </div>

        <div class="social-links hero__socials">
          <!-- Email -->
          <a href={`mailto:${profile.email}`} class="social-link" aria-label="Send email">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            <span>Email</span>
          </a>
          <!-- LinkedIn -->
          <a href="https://www.linkedin.com/in/nazozbek97/" class="social-link" target="_blank" rel="noopener" aria-label="LinkedIn">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6zM2 9h4v12H2z"/><circle cx="4" cy="4" r="2"/></svg>
            <span>LinkedIn</span>
          </a>
          <!-- GitHub -->
          <a href="https://github.com/onazozbek" class="social-link" target="_blank" rel="noopener" aria-label="GitHub">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
            <span>GitHub</span>
          </a>
        </div>
      </div>

      <div class="hero__avatar-wrap">
        <img
          src={profile.avatar}
          alt={`Portrait of ${profile.name}`}
          class="hero__avatar"
          width="280"
          height="280"
          loading="eager"
        />
        <div class="hero__avatar-badge">
          <span>Available for projects</span>
          <span class="badge-dot" aria-hidden="true"></span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
.hero {
  padding-top: calc(var(--nav-height) + var(--space-10));
  padding-bottom: var(--space-10);
}

.hero__layout {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: var(--space-10);
  align-items: center;
}

.hero__text { max-width: 540px; }

.hero__name {
  font-size: clamp(2.25rem, 5vw, 3.5rem);
  margin-bottom: var(--space-3);
  line-height: 1.1;
}

.hero__role {
  font-size: 1.05rem;
  font-weight: 500;
  color: var(--text-secondary);
  margin-bottom: var(--space-5);
}

.hero__org a {
  color: var(--text-secondary);
  font-weight: 400;
  transition: color var(--transition);
}
.hero__org a:hover { color: var(--accent); }

.hero__bio {
  font-size: 1rem;
  color: var(--text-secondary);
  max-width: 50ch;
  margin-bottom: var(--space-6);
  line-height: 1.75;
}

.hero__actions {
  display: flex;
  gap: var(--space-3);
  flex-wrap: wrap;
  margin-bottom: var(--space-6);
}

.hero__socials { margin-top: var(--space-2); }

/* Avatar */
.hero__avatar-wrap {
  position: relative;
  flex-shrink: 0;
}

.hero__avatar {
  width: 260px;
  height: 260px;
  object-fit: cover;
  border-radius: var(--radius-lg);
  border: 2px solid var(--border);
  filter: grayscale(15%);
  transition: filter var(--transition);
}
.hero__avatar:hover { filter: grayscale(0%); }

.hero__avatar-badge {
  position: absolute;
  bottom: -14px;
  left: 50%;
  transform: translateX(-50%);
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 100px;
  padding: 6px 14px;
  font-size: 0.75rem;
  font-weight: 500;
  color: var(--text-secondary);
  display: flex;
  align-items: center;
  gap: var(--space-2);
  white-space: nowrap;
  box-shadow: var(--shadow-card);
}

.badge-dot {
  width: 7px;
  height: 7px;
  background: #3D9E5B;
  border-radius: 50%;
  flex-shrink: 0;
  animation: pulse 2s infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.6; transform: scale(0.85); }
}

@media (max-width: 768px) {
  .hero {
    padding-top: calc(var(--nav-height) + var(--space-7));
    padding-bottom: var(--space-7);
  }
  .hero__layout {
    grid-template-columns: 1fr;
    gap: var(--space-7);
  }
  .hero__avatar-wrap { order: -1; }
  .hero__avatar { width: 160px; height: 160px; }
  .hero__avatar-badge { font-size: 0.7rem; bottom: -12px; }
}
</style>
