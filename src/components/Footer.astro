---
import { profile } from '../data/profile';
---

<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__brand">
      <span class="brand-initials-sm">NÖK</span>
      <span class="footer__name">{profile.name}</span>
    </div>
    <p class="footer__copy">
      &copy; {new Date().getFullYear()} · Built with <a href="https://astro.build" target="_blank" rel="noopener">Astro</a>
    </p>
    <div class="footer__links">
      <a href="https://github.com/onazozbek" target="_blank" rel="noopener" aria-label="GitHub">GitHub</a>
      <a href="https://www.linkedin.com/in/nazozbek97/" target="_blank" rel="noopener" aria-label="LinkedIn">LinkedIn</a>
      <a href="https://twitter.com/_nazozbek_" target="_blank" rel="noopener" aria-label="Twitter">Twitter</a>
      <a href={`mailto:${profile.email}`} aria-label="Email">Email</a>
    </div>
  </div>
</footer>

<style>
.footer {
  border-top: 1px solid var(--border);
  padding: var(--space-7) 0;
  background: var(--surface-alt);
}

.footer__inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: var(--space-4);
}

.footer__brand {
  display: flex;
  align-items: center;
  gap: var(--space-3);
}

.brand-initials-sm {
  width: 28px;
  height: 28px;
  background: var(--accent);
  color: #fff;
  border-radius: var(--radius);
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-display);
  font-weight: 700;
  font-size: 0.725rem;
}

.footer__name {
  font-family: var(--font-display);
  font-weight: 600;
  font-size: 0.875rem;
  color: var(--text-primary);
}

.footer__copy {
  font-size: 0.8125rem;
  color: var(--text-muted);
  margin: 0;
}

.footer__copy a {
  color: var(--text-secondary);
  font-weight: 500;
}
.footer__copy a:hover { color: var(--accent); }

.footer__links {
  display: flex;
  gap: var(--space-4);
  flex-wrap: wrap;
}

.footer__links a {
  font-size: 0.8125rem;
  font-weight: 500;
  color: var(--text-secondary);
  transition: color var(--transition);
}
.footer__links a:hover { color: var(--accent); }
</style>
